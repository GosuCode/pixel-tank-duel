# Pixel Tank Duel — reverse proxy with basic auth + rate limiting.
# Bound to loopback: only reachable by Tailscale Funnel/Serve (or local tools),
# never directly from the LAN or internet.
server {
    listen 127.0.0.1:8080;
    server_name _;

    auth_basic "Armory";
    auth_basic_user_file /etc/nginx/.htpasswd-pixel;

    # Tailscale Funnel/Serve proxies from loopback; recover the real client IP
    # from X-Forwarded-For so the per-IP limits below actually work.
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    limit_req zone=game burst=15 nodelay;
    limit_conn perip 6;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
